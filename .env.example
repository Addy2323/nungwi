# Run on a persistent Node.js host. Use HTTPS in production.
APP_URL=http://localhost:3000
DATABASE_PATH=./data/nungwi.sqlite
UPLOAD_DIR=./data/uploads
BACKUP_DIR=./backups

# Public shop details. Leave blank until confirmed.
SHOP_PHONE=
SHOP_EMAIL=
SHOP_HOURS=
SHOP_HOURS_SW=

# SMS: queued messages remain queued until all three values are supplied.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Account invitation/reset email provider.
RESEND_API_KEY=
EMAIL_FROM=

# Optional card payments. Both values are required to offer card checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
