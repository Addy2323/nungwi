# Run on a persistent Node.js host. Use HTTPS in production.
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://nungwi_app:CHANGE_ME@localhost:5432/nungwi?schema=public
# Administrative connection is only used by migration/backup tools.
DATABASE_ADMIN_URL=postgresql://postgres:CHANGE_ME@localhost:5432/nungwi?schema=public
# Optional path to PostgreSQL tools on Windows.
PG_BIN=C:/Program Files/PostgreSQL/18/bin
UPLOAD_DIR=./data/uploads
BACKUP_DIR=./backups

# Public shop details. Leave blank until confirmed.
SHOP_PHONE=
SHOP_EMAIL=
SHOP_HOURS=
SHOP_HOURS_SW=

# Verified public business details for LocalBusiness structured data.
# Without a verified street address the site emits Organization, not a guessed storefront.
SHOP_STREET_ADDRESS=
SHOP_LOCALITY=Nungwi
SHOP_LATITUDE=
SHOP_LONGITUDE=
# Schema.org format, semicolon separated, e.g. Mo-Sa 09:00-22:00;Su 10:00-20:00
SHOP_OPENING_HOURS=
# Comma-separated HTTPS image hostnames to enable remote image optimization.
# Leave empty for local /images and /uploads assets only. Rebuild after changing.
NEXT_PUBLIC_IMAGE_HOSTS=
# Optional Search Console HTML verification token. DNS verification is also supported externally.
GOOGLE_SITE_VERIFICATION=
# Reserved for a future consent-aware GA4 integration; no GA4 script is enabled by this setting.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# SMS: queued messages remain queued until all three values are supplied.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Account invitation/reset email provider.
RESEND_API_KEY=
EMAIL_FROM=

# Optional card payments. Both values are required to offer card checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SMS provider (MackSMS or Twilio); never use NEXT_PUBLIC_ for credentials.
SMS_PROVIDER=macksms
SMS_BASE_URL=https://macksms.co.tz/portal/api/
SMS_SENDER_ID=
# Full Basic header or Base64 account API key, OR the secret pair below.
SMS_API_KEY=
SMS_API_SECRET=
SMS_SECRET_CODE=
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SMS_ENCRYPTION_KEY=
SHOP_LOCATION=
